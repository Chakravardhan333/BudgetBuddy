# BudgetBuddy Backend Environment Configuration Template
SECRET_KEY=your-secure-random-secret-key-at-least-50-characters
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# Database URL (Leave blank for local SQLite; Provide for Render PostgreSQL)
# Format: postgresql://user:password@host:port/database_name
DATABASE_URL=

# CORS Allowed Origins (Comma-separated frontend domains)
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://budgetbuddy.vercel.app

# Optional Production Email Delivery (e.g., SendGrid, Mailgun, Amazon SES)
# Leave blank to log emails safely to the backend terminal
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=BudgetBuddy <noreply@budgetbuddy.app>
